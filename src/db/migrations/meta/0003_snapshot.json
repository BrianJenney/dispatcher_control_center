          "value": "case \"trips\".\"status\"\n        when 'offer' then \"trips\".\"driver_id\" is null\n        when 'cancelled' then true\n        else \"trips\".\"driver_id\" is not null\n      end"
        },
        "trips_cancel_reason_matches_status": {
          "name": "trips_cancel_reason_matches_status",
          "value": "(\"trips\".\"status\" = 'cancelled') = (\"trips\".\"cancel_reason\" is not null and char_length(btrim(\"trips\".\"cancel_reason\")) > 0)"
        }
      },
      "isRLSEnabled": false
    },
